# ============================================================================
.discovery/logs/
.discovery/runtime/
.discovery/sessions/
.discovery/toolcatalog/
.discovery/agent-runs/
.discovery/engine-runs/
.discovery/host-tools/

# Transient engine CLI run logs (verbose; may echo retrieved copyrighted text)
.discovery/engine/copilot-cli/logs/
.discovery/engine/copilot-cli/*.log

# Machine-specific model-router config (localhost endpoints / ports)
.discovery/llm-router.json

