{
  "flowId": "data-analysis-pipeline",
  "name": "Data Analysis Pipeline",
  "description": "End-to-end data processing pipeline from ingestion through interpretation. Engine-driven data processing with human interpretation.",
  "category": "analysis",
  "version": "1.0.0",
  "parameters": [
    {
      "name": "dataSource",
      "type": "string",
      "description": "Data source path or identifier (e.g., \u0027experiments/2026-Q1/raw-data.csv\u0027).",
      "required": true
    },
    {
      "name": "outputFormat",
      "type": "choice",
      "description": "Preferred output format for results.",
      "required": false,
      "default": "notebook",
      "choices": [
        "notebook",
        "report",
        "dashboard",
        "csv"
      ]
    },
    {
      "name": "includeOutlierAnalysis",
      "type": "boolean",
      "description": "Whether to include outlier detection and analysis.",
      "required": false,
      "default": true
    }
  ],
  "taskTemplates": [
    {
      "templateNodeId": "ingest",
      "title": "Ingest data from {{dataSource}}",
      "description": "Load raw data, validate format, and create initial data profile (row count, column types, missing values).",
      "acceptanceCriteria": [
        "Data loaded successfully",
        "Schema documented",
        "Row and column counts verified",
        "Missing value report generated"
      ],
      "labels": [
        "analysis",
        "data-engineering",
        "automated"
      ],
      "assignmentHint": "engine:grz-worker",
      "estimatedEffort": "15m"
    },
    {
      "templateNodeId": "clean",
      "title": "Clean and validate data",
      "description": "Handle missing values, remove duplicates, fix data types, and validate against expected schema.",
      "acceptanceCriteria": [
        "Missing values handled (imputed or documented)",
        "Duplicates removed",
        "Data types consistent",
        "Validation report generated"
      ],
      "labels": [
        "analysis",
        "data-engineering",
        "automated"
      ],
      "assignmentHint": "engine:grz-worker",
      "estimatedEffort": "30m"
    },
    {
      "templateNodeId": "transform",
      "title": "Transform and feature-engineer data",
      "description": "Apply transformations: normalization, encoding, feature engineering. Prepare data for analysis.",
      "acceptanceCriteria": [
        "Features documented with descriptions",
        "Transformations reproducible",
        "Feature correlation matrix computed",
        "Output dataset saved"
      ],
      "labels": [
        "analysis",
        "data-engineering",
        "automated"
      ],
      "assignmentHint": "engine:grz-worker",
      "estimatedEffort": "45m"
    },
    {
      "templateNodeId": "visualize",
      "title": "Generate visualizations",
      "description": "Create exploratory and summary visualizations. Output as {{outputFormat}}.",
      "acceptanceCriteria": [
        "Distribution plots for key variables",
        "Correlation heatmap",
        "Time series plots (if applicable)",
        "Outlier visualization (if requested)",
        "All plots labeled and titled"
      ],
      "labels": [
        "analysis",
        "visualization",
        "automated"
      ],
      "assignmentHint": "engine:grz-worker",
      "estimatedEffort": "30m"
    },
    {
      "templateNodeId": "interpret",
      "title": "Interpret results and write summary",
      "description": "Review analysis results, identify key insights, and write an actionable summary with recommendations.",
      "acceptanceCriteria": [
        "Key findings listed with supporting data",
        "Limitations of the analysis documented",
        "Actionable recommendations provided",
        "Summary reviewed for accuracy"
      ],
      "labels": [
        "analysis",
        "interpretation"
      ],
      "assignmentHint": "human",
      "estimatedEffort": "1h"
    }
  ],
  "edgeTemplates": [
    {
      "from": "ingest",
      "to": "clean",
      "type": "dependency"
    },
    {
      "from": "clean",
      "to": "transform",
      "type": "dependency"
    },
    {
      "from": "transform",
      "to": "visualize",
      "type": "dependency"
    },
    {
      "from": "visualize",
      "to": "interpret",
      "type": "dependency"
    }
  ],
  "engineBinding": {
    "definitionId": "grz-worker",
    "triggerOn": "on-ready-tasks"
  }
}